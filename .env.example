# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=60
MAX_ATTEMPTS=5
REQUEST_TIMEOUT_SECONDS=30

# ─── Management API ──────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080

# ─── SQL Server (the polling service's OWN database/schema; never a consumer's) ──
# The [polling] schema + tables are created inside whatever database you name here.
# DATABASE_URL accepts EITHER format:
#   1) SQLAlchemy URL:
#      mssql+pyodbc://USER:PASSWORD@HOST:1433/YOUR_DATABASE?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#   2) Raw ODBC connection string:
#      Driver={ODBC Driver 18 for SQL Server};Server=HOST,1433;Database=YOUR_DATABASE;Uid=USER;Pwd=PASSWORD;TrustServerCertificate=yes;
DATABASE_URL=Driver={ODBC Driver 18 for SQL Server};Server=HOST,1433;Database=YOUR_DATABASE;Uid=USER;Pwd=PASSWORD;TrustServerCertificate=yes;
STATE_SCHEMA=polling
# Create the [polling] schema + tables at startup if missing (runs migrations/*.sql).
BOOTSTRAP_STATE_TABLE=true

# ─── Auth (JWT bearer; API key -> JWT at POST /auth/token) ───────────────────
JWT_ALG=HS256
JWT_SECRET=change-me-to-a-long-random-secret
# For RS256 instead, set one of these and JWT_ALG=RS256:
# JWT_PUBLIC_KEY=
# JWT_JWKS_URL=
JWT_ISSUER=os2forms-polling-service
JWT_AUDIENCE=os2forms-polling-service
JWT_TTL_SECONDS=3600
# Optional: seed an admin API key at startup if no admin key exists yet.
BOOTSTRAP_ADMIN_KEY=

# ─── OS2forms (Drupal webform_rest) ──────────────────────────────────────────
OS2FORMS_BASE_URL=https://YOUR-OS2FORMS-HOST/da
OS2FORMS_API_KEY=changeme
OS2FORMS_VERIFY_SSL=true
OS2FORMS_TIMEOUT=30

# ─── Automation Server (default destination) ─────────────────────────────────
AUTOMATION_SERVER_URL=http://automation-server-proxy
AUTOMATION_SERVER_API_KEY=changeme
AUTOMATION_SERVER_API_PREFIX=/api
AUTOMATION_SERVER_VERIFY_SSL=true
AUTOMATION_SERVER_TIMEOUT=30

# ─── Retention ───────────────────────────────────────────────────────────────
# Unit for the PollJob.erase_after value. Assumed days until confirmed.
ERASE_AFTER_UNIT=days
